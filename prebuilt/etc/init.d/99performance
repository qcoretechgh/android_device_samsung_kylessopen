#!/system/bin/sh
echo interactive > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
echo 480000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
echo 60 > /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
echo 1008000 > /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
echo 30000 > /sys/devices/system/cpu/cpufreq/interactive/min_sample_time
echo 20000 > /sys/devices/system/cpu/cpufreq/interactive/timer_rate

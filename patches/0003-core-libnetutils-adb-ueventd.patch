diff --git a/libnetutils/ifc_utils.c b/libnetutils/ifc_utils.c
index bde336f..a979e1f 100644
--- a/libnetutils/ifc_utils.c
+++ b/libnetutils/ifc_utils.c
@@ -30,6 +30,9 @@
 #include <linux/sockios.h>
 #include <linux/route.h>
 #include <linux/wireless.h>
+#include <linux/netlink.h>
+#include <linux/rtnetlink.h>
+#include <linux/if_addr.h>
 
 #ifdef ANDROID
 #define LOG_TAG "NetUtils"
@@ -436,3 +439,85 @@ ifc_configure(const char *ifname,
 
     return 0;
 }
+
+/*
+ * Remove an IPv4 or IPv6 address from the specified interface via netlink.
+ */
+int ifc_del_address(const char *name, const char *address, int prefixlen)
+{
+    int ifindex, s, len, ret;
+    struct sockaddr_nl nladdr;
+    struct {
+        struct nlmsghdr n;
+        struct ifaddrmsg ifa;
+        char buf[256];
+    } req;
+    struct rtattr *rta;
+    union {
+        struct in_addr v4;
+        struct in6_addr v6;
+    } addr;
+    int family, addrlen;
+
+    if (!name || !address) {
+        return -EINVAL;
+    }
+
+    ifindex = if_nametoindex(name);
+    if (ifindex == 0) {
+        return -errno;
+    }
+
+    if (inet_pton(AF_INET, address, &addr.v4) == 1) {
+        family = AF_INET;
+        addrlen = sizeof(addr.v4);
+    } else if (inet_pton(AF_INET6, address, &addr.v6) == 1) {
+        family = AF_INET6;
+        addrlen = sizeof(addr.v6);
+    } else {
+        return -EINVAL;
+    }
+
+    memset(&req, 0, sizeof(req));
+    req.n.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifaddrmsg));
+    req.n.nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+    req.n.nlmsg_type = RTM_DELADDR;
+
+    req.ifa.ifa_family = family;
+    req.ifa.ifa_prefixlen = prefixlen;
+    req.ifa.ifa_index = ifindex;
+
+    rta = (struct rtattr *)(((char *)&req) + NLMSG_ALIGN(req.n.nlmsg_len));
+    rta->rta_type = IFA_LOCAL;
+    rta->rta_len = RTA_LENGTH(addrlen);
+    memcpy(RTA_DATA(rta), &addr, addrlen);
+    req.n.nlmsg_len = NLMSG_ALIGN(req.n.nlmsg_len) + RTA_ALIGN(rta->rta_len);
+
+    s = socket(PF_NETLINK, SOCK_RAW, NETLINK_ROUTE);
+    if (s < 0) {
+        return -errno;
+    }
+
+    memset(&nladdr, 0, sizeof(nladdr));
+    nladdr.nl_family = AF_NETLINK;
+    ret = sendto(s, &req, req.n.nlmsg_len, 0, (struct sockaddr *)&nladdr, sizeof(nladdr));
+    if (ret < 0) {
+        ret = -errno;
+        close(s);
+        return ret;
+    }
+
+    len = recv(s, &req, sizeof(req), 0);
+    close(s);
+    if (len < 0) {
+        return -errno;
+    }
+    if (req.n.nlmsg_type == NLMSG_ERROR) {
+        struct nlmsgerr *err = (struct nlmsgerr *)NLMSG_DATA(&req.n);
+        if (err->error < 0) {
+            return err->error;
+        }
+    }
+
+    return 0;
+}

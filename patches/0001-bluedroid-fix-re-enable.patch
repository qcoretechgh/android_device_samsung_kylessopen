+        LOGE("Error stopping hciattach");
+        return;
+    }
+    for (i = 0; i < 20; i++) {
+        if (property_get("init.svc.hciattach", svc_state, "") > 0 &&
+            strcmp(svc_state, "running") != 0) {
+            break;
+        }
+        usleep(50000);
+    }

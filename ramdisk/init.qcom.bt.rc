service bccmd /system/bin/logwrapper /system/bin/bccmd -t bcsp -d /dev/ttyHS0 psload -r /etc/PSConfig_7820_rev26.psr
    user root
    group bluetooth net_bt_admin
    disabled
    oneshot

service hciattach /system/bin/logwrapper /system/bin/hciattach -n -p /dev/ttyHS0 bcsp 3000000 flow
    user root
    group bluetooth net_bt_admin
    disabled
    oneshot

on property:init.svc.bluetoothd=running
    start hci0_up

on property:init.svc.bluetoothd=stopped
    start hci0_down

service hci0_up /system/xbin/hciconfig hci0 up
    class main
    group bluetooth
    disabled
    oneshot

service hci0_down /system/xbin/hciconfig hci0 down
    class main
    group bluetooth
    disabled
    oneshot
